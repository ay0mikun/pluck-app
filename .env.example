# Optional: enables official X API imports. Paste the token below if needed.
X_BEARER_TOKEN=
PORT=5173

# Social login credentials. Paste your client IDs and secrets below.
# Use the exact same origin in the browser and provider callback settings.
# APP_ORIGIN=http://127.0.0.1:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# Email sign-in links use implicit TLS (usually port 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Local development only. Show sign-in links without SMTP.
LOCAL_EMAIL_PREVIEW=

# Fill empty libraries on local preview sign-in with Figma samples.
LOCAL_FILLED_LIBRARY=


# Hosted staging: Render supplies PORT; Supabase persists records and images.
# HOST=0.0.0.0
# APP_ORIGIN=https://your-staging-service.onrender.com
# Set LOCAL_EMAIL_PREVIEW=0 and LOCAL_FILLED_LIBRARY=0 for shared staging.

# Hosted staging credentials. Set these on Render, or locally to test Supabase.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pluck-media
RESEND_API_KEY=
EMAIL_FROM=

# Vercel static app build only (public backend URL; never use a Supabase key).
# Set separately for Production and Preview in Vercel.
# PLUCK_API_ORIGIN=https://your-production-backend.onrender.com
