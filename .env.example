# Optional: enables official X API imports. Paste the token below if needed.
X_BEARER_TOKEN=
PORT=5173

# Social login credentials. Paste your client IDs and secrets below.
# Use the exact same origin in the browser and provider callback settings.
# APP_ORIGIN=http://127.0.0.1:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# Email sign-in links use implicit TLS (usually port 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Local development only. Show sign-in links without SMTP.
LOCAL_EMAIL_PREVIEW=

# Fill empty libraries on local preview sign-in with Figma samples.
LOCAL_FILLED_LIBRARY=


# Hosted staging: use the service's assigned PORT and a persistent data directory.
# HOST=0.0.0.0
# APP_ORIGIN=https://your-staging-service.onrender.com
# MOODBOARD_DATA_DIR=/var/data/pluck
# PLUCK_STAGING=1
# Set LOCAL_EMAIL_PREVIEW=0 and LOCAL_FILLED_LIBRARY=0 for shared staging.
